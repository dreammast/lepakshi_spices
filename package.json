{
  "name": "lepakshi-spices",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm --prefix apps/user run build",
    "dev:user": "npm --prefix apps/user run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:server": "npm --prefix server run dev",
    "build:user": "npm --prefix apps/user run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:server": "npm --prefix server run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "node database/reset-tables.mjs",
    "db:seed": "node database/seed/seed-data.mjs",
    "db:backup-clear": "node database/seed/backup-and-clear.mjs",
    "check:db": "node scripts/db-check.mjs",
    "check:api": "node scripts/api-check.mjs",
    "db:apply-admin-activity": "node scripts/apply-admin-activity-migration.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.16.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
